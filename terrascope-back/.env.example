NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
MONGO_URI=mongodb://localhost:27017/terrascope
GEMINI_API_KEY=
EMAIL_USER=
EMAIL_PASSWORD=

# Required only when NODE_ENV=production
HTTPS_PORT=443
HTTP_PORT=80
HTTPS_KEY_PATH=/absolute/path/to/privkey.pem
HTTPS_CERT_PATH=/absolute/path/to/fullchain.pem